# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python Cache & Bytecode
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.*.local
*.pem
*.key

# Logs & Runtime Artifacts
*.log
ingestion_error.log
ingestion_output.txt
logs/

# Heavy Raw Data Dumps (>100MB / Multi-GB PDF files)
raw/

# Heavy intermediate document parsing dumps (re-generable via scripts)
processed/documents/
processed/extracted/

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary database files
database/*.db-journal
database/*.db-wal
database/*.db-shm
